pkgname=nutsync
pkgver=0.4.1
pkgrel=1
pkgdesc='Two-way WebDAV synchronization client for the KDE desktop'
arch=('x86_64')
url='https://github.com/gomodb/nutsync'
license=('GPL-3.0-or-later')
depends=(
    'qt6-base'
    'qt6-svg'
    'qt6-translations'
    'qtkeychain-qt6'
    'kstatusnotifieritem'
    'knotifications'
)
makedepends=('cmake' 'ninja' 'qt6-tools')
checkdepends=('python')
source=("$pkgname-$pkgver.tar.gz::https://github.com/gomodb/nutsync/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4be417ee636b0d6b628a0e1883734db5440472039abcab6d364b115c386c900b')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON \
        -Wno-dev
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
