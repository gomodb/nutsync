pkgname=nutsync
pkgver=0.6.4
pkgrel=1
pkgdesc='Two-way WebDAV synchronization client for the KDE desktop'
arch=('x86_64' 'aarch64')
url='https://github.com/gomodb/nutsync'
license=('GPL-3.0-or-later')
depends=(
    'qt6-base'
    'qt6-networkauth'
    'qt6-svg'
    'qt6-translations'
    'qtkeychain-qt6'
    'kstatusnotifieritem'
    'knotifications'
)
makedepends=('cmake' 'ninja' 'qt6-tools')
checkdepends=('python')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/gomodb/nutsync/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('555866e2a0bc3f90629cebbce2fe001a2045ab89d0ccaa1a472a2705797a6f67')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B "$srcdir/$pkgname-$pkgver/build" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON \
        -Wno-dev
    cmake --build "$srcdir/$pkgname-$pkgver/build"
}

check() {
    ctest --test-dir "$srcdir/$pkgname-$pkgver/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/$pkgname-$pkgver/build"
    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
