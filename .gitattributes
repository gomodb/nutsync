# Normalize text files for a Linux-first project.
* text=auto eol=lf

# Binary assets must not be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.zst binary
*.gz binary

# Keep scripts and package recipes LF-only.
*.sh text eol=lf
*.py text eol=lf
PKGBUILD text eol=lf
.SRCINFO text eol=lf
.clang-format text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# AUR packaging is not part of the upstream source archive.
packaging/arch export-ignore
