pkgname=nutsync
pkgver=0.4.7
pkgrel=1
pkgdesc='Two-way WebDAV synchronization client for the KDE desktop'
arch=('x86_64' 'aarch64')
url='https://github.com/gomodb/nutsync'
license=('GPL-3.0-or-later')
depends=(
    'qt6-base'
    'qt6-svg'
    'qt6-translations'
    'qtkeychain-qt6'
    'kstatusnotifieritem'
    'knotifications'
)
makedepends=('cmake' 'ninja' 'qt6-tools')
checkdepends=('python')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/gomodb/nutsync/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('4092d52bf3fbe903c96aaad0f5f7698cbd3f1a7916379bfe1ce19010328d57a9')

build() {
    cmake -S "$srcdir/$pkgname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON \
        -Wno-dev
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
